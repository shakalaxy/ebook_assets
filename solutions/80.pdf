   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Child reading book in bed. Kids read at night.</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Child reading book in bed. Kids read at night. Little boy with fairy tale books in bedroom . Education for young children. Bedtime story in the evening. Cute kid under blanket in dark room with lamp.</rdf:li>
    </rdf:Alt>
   </dc:description>
