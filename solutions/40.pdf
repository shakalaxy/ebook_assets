   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Dying and decaying peonie flowers</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Once beautiful pink peonie flowers are now dying and drooping as they reach the last stages of life in a Missouri yard. Bokeh.</rdf:li>
    </rdf:Alt>
   </dc:description>
